{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nubix Software",
  "version": "0.5.0",
  "identifier": "com.nubixsoftware.demo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nubix Software",
        "width": 1366,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 700,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nubix Software",
    "copyright": "© 2026 Nubix Software",
    "category": "Business",
    "shortDescription": "Punto de venta e inventario para kioscos",
    "longDescription": "Nubix Software: punto de venta, caja, inventario, fiado y facturación para kioscos y comercios de barrio. Versión demo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
